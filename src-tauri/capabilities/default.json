{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "ai-prompts-*"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "*" },
        { "url": "**" },
        { "url": "https://kimi.moonshot.cn/**" }
      ]
    }
  ]
}
