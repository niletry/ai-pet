name = "ai-pet-prompts-api"
main = "src/index.ts"
compatibility_date = "2024-04-01"

[[d1_databases]]
binding = "DB"
database_name = "ai_pet_db"
database_id = "YOUR_DATABASE_ID_HERE" # 从 npx wrangler d1 create ai_pet_db 获取

[[routes]]
pattern = "ai-pet-prompts-api.code123.in"
custom_domain = true

[observability]
enabled = true
